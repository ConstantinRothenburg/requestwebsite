# Prismic Configuration
# Copy this file to .env (git-ignored). Never commit secrets.

# Prismic repository name (the subdomain in https://<repo>.prismic.io)
NEXT_PUBLIC_PRISMIC_REPOSITORY_NAME=request

# Optional: if your repository is private or you use environments
PRISMIC_ACCESS_TOKEN=

# Optional: override repositoryName at runtime
NEXT_PUBLIC_PRISMIC_ENVIRONMENT=

# Optional: webhook shared secret header value
PRISMIC_WEBHOOK_SECRET=

# Preview URLs (reference only)
# Local:  http://localhost:3000/api/preview
# Cloud:  https://request-beryl.vercel.app/api/preview
