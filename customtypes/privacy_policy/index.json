{
  "id": "privacy_policy",
  "label": "Privacy Policy",
  "format": "custom",
  "repeatable": false,
  "status": true,
  "json": {
    "Main": {
      "title": {
        "type": "StructuredText",
        "config": {
          "label": "Title",
          "placeholder": "Privacy Policy / Datenschutz",
          "single": "heading1"
        }
      },
      "content": {
        "type": "StructuredText",
        "config": {
          "label": "Content",
          "placeholder": "Privacy policy content...",
          "multi": "paragraph,strong,em,hyperlink,list-item,o-list-item"
        }
      }
    },
    "SEO & Metadata": {
      "meta_title": {
        "type": "Text",
        "config": {
          "label": "Meta Title",
          "placeholder": "Privacy Policy - Request Website"
        }
      },
      "meta_description": {
        "type": "Text",
        "config": {
          "label": "Meta Description",
          "placeholder": "Privacy policy information"
        }
      }
    }
  }
}
