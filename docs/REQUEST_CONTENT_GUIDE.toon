Meta{format:TOON_v2.1.0,project:Request-Website-v2.0,document:REQUEST_CONTENT_GUIDE,updated:2026-02-08}:

Summary{purpose}:
- Populate_Prismic_content_for_Request_v2
- Validate_previews_local_and_cloud

Repository{prismic}:
- RepoName:request
- RepoURL:https://request.prismic.io
- APIEndpoint:https://request.cdn.prismic.io/api/v2

SiteSettings{singleton}:
- BrandColors:#E50051,#B0003A,#FF4D7F,#FFFFFF,#0B0B0C
- Typography:Sora_body,Manrope_headings,16px,1.25,1.5
- Layout:1200px,Normal,16px
- HeaderNav:Home(/),About(/about),Request(/request)
- Footer:Instagram,LinkedIn,Imprint(/imprint),Privacy(/privacy)

HomePage{page_uid:home}:
- Title:Request Website
- SlicesOrder:Hero,FeaturesGrid,FullScreenSection,CTABanner,Footer
- Hero:Tagline,Headline,Subtitle,2_CTAs
- FeaturesGrid:3_to_6_items
- FullScreenSection:optional_video
- CTABanner:headline,description,button
- Footer:Imprint,Privacy,Contact
- SEO:MetaTitle,MetaDescription,MetaImage

Imprint{singleton}:
- Title:Imprint
- Content:legal_imprint_text
- SEO:MetaTitle,MetaDescription

PrivacyPolicy{singleton}:
- Title:Privacy Policy
- Content:privacy_policy_text
- SEO:MetaTitle,MetaDescription

Media{required}:
- HeaderLogo
- MetaImage(1200x630)
- Optional:HeroBackground,VideoURL

PreviewSetup{required}:
- Local:http://localhost:3000/api/preview
- Cloud:https://request-beryl.vercel.app/api/preview
- Note:Use_app_domain_only

Webhook{optional}:
- URL:https://request-beryl.vercel.app/api/revalidate
- Header:x-prismic-webhook-secret

Validation{checklist}:
- Documents_published
- Preview_redirects_to_app_domain
- Home_page_renders_slices

Report{required}:
- Document_IDs
- Preview_status
- Missing_assets
