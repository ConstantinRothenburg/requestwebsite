{
  "id": "features_grid",
  "type": "SharedSlice",
  "name": "FeaturesGrid",
  "description": "3-column grid of feature cards with icons, titles, descriptions, and links",
  "variations": [{
    "id": "default",
    "name": "Default",
    "docURL": "...",
    "version": "initial",
    "description": "Default FeaturesGrid variation",
    "imageUrl": "",
    "primary": {
      "features": {"type": "Group", "config": {"label": "Features", "fields": {
        "icon": {"type": "Select", "config": {"label": "Icon", "options": ["Network", "Vision", "Movement", "Globe", "Users", "Rocket"]}},
        "title": {"type": "Text", "config": {"label": "Title", "placeholder": "Connect Globally"}},
        "description": {"type": "StructuredText", "config": {"label": "Description", "multi": "paragraph, strong, em", "placeholder": "Network with climate innovators worldwide..."}},
        "link": {"type": "Link", "config": {"label": "Link", "allowText": true}}
      }}},
      "appearance_background_color": {"type": "Color", "config": {"label": "Appearance: Background Color"}},
      "appearance_background_gradient": {"type": "Text", "config": {"label": "Appearance: Background Gradient", "placeholder": "linear-gradient(135deg, #E50051 0%, #B0003A 100%)"}},
      "appearance_background_image": {"type": "Image", "config": {"label": "Appearance: Background Image"}},
      "appearance_text_color": {"type": "Color", "config": {"label": "Appearance: Text Color"}},
      "appearance_align": {"type": "Select", "config": {"label": "Appearance: Text Alignment", "options": ["Left", "Center", "Right"], "default_value": "Left"}},
      "appearance_padding": {"type": "Select", "config": {"label": "Appearance: Vertical Padding", "options": ["S", "M", "L"], "default_value": "M"}},
      "appearance_container_width": {"type": "Select", "config": {"label": "Appearance: Container Width", "options": ["Narrow", "Normal", "Wide"], "default_value": "Normal"}}
    }
  }]}
